<?php
session_start();
require 'config.php';

if (isset($_POST['login'])) {

    $username = trim($_POST['username']);
    $password = trim($_POST['password']);

    // Check user function
    function checkUser($conn, $username, $table) {

        $stmt = $conn->prepare("SELECT * FROM $table WHERE username = ?");
        $stmt->bind_param("s", $username);

        $stmt->execute();

        $result = $stmt->get_result();

        return $result->fetch_assoc();
    }

    // Check Admin Login
    $admin = checkUser($conn, $username, "admin_login");

    if ($admin && base64_decode($admin['password']) === $password) {

        $_SESSION['user_id'] = $admin['sno'];
        $_SESSION['username'] = $admin['username'];

        header("Location: dashboard.php");
        exit();
    }

    // Check Student Login
    $student = checkUser($conn, $username, "student_login");

    if ($student && base64_decode($student['password']) === $password) {

        $_SESSION['user_id'] = $student['sno'];
        $_SESSION['username'] = $student['username'];

        header("Location: student_dashboard.php");
        exit();
    }

    // Invalid Login
    $error = "Invalid Username or Password!";
}
